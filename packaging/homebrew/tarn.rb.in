cask "tarn" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@REPO@/releases/download/v#{version}/Tarn-v#{version}.dmg",
      verified: "github.com/@REPO@/"
  name "Tarn"
  desc "Keyboard-first browser with built-in tracker and ad blocking"
  homepage "https://tarnbrowser.com/"

  livecheck do
    url :url
    strategy :github_latest
  end

  auto_updates true
  depends_on macos: :sonoma

  app "Tarn.app"

  zap trash: [
    "~/Library/Application Support/Tarn",
    "~/Library/Caches/de.quavon.tarn",
    "~/Library/HTTPStorages/de.quavon.tarn",
    "~/Library/Preferences/de.quavon.tarn.plist",
    "~/Library/Saved Application State/de.quavon.tarn.savedState",
    "~/Library/WebKit/de.quavon.tarn",
  ]
end
